{
  "id": "sera-m-creator-impact",
  "name": "Creator Impact Yellow",
  "nameZh": "口播冲击 · 黄",
  "category": "Bold",
  "categories": [
    "Bold"
  ],
  "priority": "signature",
  "description": "粗体大字 + 黑描边 + 轻投影，当前词黄色并以 snap 快速落位。1–3 词节奏。",
  "descriptionEn": "Heavy condensed type with a black outline and a soft shadow; the active word snaps in yellow. 1–3 word rhythm.",
  "tags": [
    "master",
    "creator",
    "impact"
  ],
  "layout": {
    "maxLines": 1,
    "position": "bottom",
    "yOffset": 0.16,
    "align": "center",
    "maxWidth": 0.86,
    "aspect": "16:9",
    "safeArea": false
  },
  "typography": {
    "fontFamily": "uppercaseTight",
    "fontWeight": 800,
    "fontSize": 76,
    "letterSpacing": 0.005,
    "lineHeight": 1.1,
    "textTransform": "none"
  },
  "text": {
    "text": "#FFFFFF",
    "idle": "rgba(255,255,255,0.56)",
    "active": "#FFD400",
    "keyword": "#FFD400",
    "number": "#FFD400"
  },
  "activeWord": {
    "color": "#FFD400",
    "scale": 1.08,
    "animation": "highlight"
  },
  "number": {
    "color": "#FFD400",
    "scale": 1.2,
    "fontWeight": 800
  },
  "emphasis": {
    "numbers": true,
    "percentages": true,
    "currency": true,
    "keywords": [],
    "aiEmphasis": false,
    "numberScale": 1.2,
    "numberWeight": 800,
    "numberColor": "#FFD400",
    "keywordWeight": 800
  },
  "background": {
    "type": "none",
    "opacity": 1,
    "blur": 6,
    "radius": 20,
    "paddingX": 22,
    "paddingY": 12
  },
  "border": {
    "type": "none",
    "color": "#4F8CFF",
    "width": 3,
    "radius": 16
  },
  "motion": {
    "entrance": {
      "type": "fade",
      "duration": 160
    },
    "word": {
      "type": "highlight",
      "duration": 160,
      "intensity": 1
    },
    "exit": {
      "type": "fade",
      "duration": 120
    },
    "decorator": "snap"
  },
  "rhythm": {
    "mode": "word",
    "maxWords": 3,
    "combineWithinMs": 550,
    "pauseBreakMs": 260,
    "punctuationBreak": true,
    "density": "tight"
  },
  "preview": {
    "contexts": [
      "creator"
    ],
    "demoText": "你只需要记住这一件事。"
  },
  "treatment": {
    "stroke": {
      "enabled": true,
      "color": "#000000",
      "width": 4
    },
    "shadow": {
      "enabled": true,
      "x": 0,
      "y": 2,
      "blur": 10,
      "color": "rgba(0,0,0,0.5)"
    }
  }
}