{
  "name": "sera-subtitle-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Design subtitles like UI components. Caption engine + studio + library + recipes.",
  "scripts": {
    "dev": "next dev -p 4310",
    "build": "next build",
    "start": "next start -p 4310",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "export": "SSF_EXPORT=1 next build",
    "static": "SSF_EXPORT=1 next build && node scripts/serve.mjs",
